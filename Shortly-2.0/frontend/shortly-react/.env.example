# Shortly 2.0 Frontend Environment Variables Example
# Duplicate this file to .env or .env.local for local overrides

# Local Spring Boot backend:
# VITE_API_BASE_URL=http://localhost:8080/api

# Production Spring Boot backend (e.g. Render, Railway, AWS):
# VITE_API_BASE_URL=https://your-backend-api.onrender.com/api

# If left unset, the frontend runs with local backend fallback (http://localhost:8080/api)
# and graceful client-side demo mode if the server is unreachable.
